 	&uvcg_frame_attr_b_frame_index,
 	&uvcg_frame_attr_bm_capabilities,
 	&uvcg_frame_attr_w_width,
@@ -2118,12 +2128,31 @@
 	NULL,
 };
 
-static const struct config_item_type uvcg_frame_type = {
