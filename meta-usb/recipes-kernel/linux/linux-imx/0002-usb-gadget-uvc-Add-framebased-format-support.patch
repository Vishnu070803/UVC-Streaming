From 14f1365cd77d1cc00c090ff98bb55c09e07dd3d5 Mon Sep 17 00:00:00 2001
From: S-Vishnu <vishnuvardhan.siddavatam@vconnectech.in>
Date: Fri, 24 Apr 2026 22:56:37 +0530
Subject: [PATCH] usb: gadget: uvc: Add framebased format support

This adds support for framebased format (such as H.264) to the UVC
configfs gadget driver, which is missing in the imx lf-6.12.y kernel.

Upstream-Status: Backport [https://patchwork.kernel.org/project/linux-usb/patch/20240927152138.31416-1-quic_akakum@quicinc.com]
---
 drivers/usb/gadget/function/uvc_configfs.c | 348 ++++++++++++++++++++-
 drivers/usb/gadget/function/uvc_configfs.h |  16 +
 drivers/usb/gadget/function/uvc_v4l2.c     |  11 +-
 include/uapi/linux/usb/video.h             |  58 ++++
 4 files changed, 421 insertions(+), 12 deletions(-)

diff --git a/drivers/usb/gadget/function/uvc_configfs.c b/drivers/usb/gadget/function/uvc_configfs.c
index 6fac696..f131943 100644
--- a/drivers/usb/gadget/function/uvc_configfs.c
+++ b/drivers/usb/gadget/function/uvc_configfs.c
@@ -1566,11 +1566,13 @@
 /* -----------------------------------------------------------------------------
  * streaming/uncompressed
  * streaming/mjpeg
+ * streaming/framebased
  */
 
 static const char * const uvcg_format_names[] = {
 	"uncompressed",
 	"mjpeg",
+	"framebased",
 };
 
 static struct uvcg_color_matching *
@@ -1777,6 +1779,9 @@
 	target_fmt = container_of(to_config_group(target), struct uvcg_format,
 				  group);
 
+	if (!target_fmt)
+		goto out;
+
